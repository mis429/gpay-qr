# Copy this file to ".env" and fill in your real values.
# Get these from Razorpay Dashboard -> Settings -> API Keys.
# Use "rzp_test_..." keys while developing, "rzp_live_..." after KYC to accept real money.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Shown to the customer on the payment / in your records
MERCHANT_NAME=Adinath Industries

# Optional: your own UPI ID (e.g. yourname@okhdfcbank).
# Only used by the "offline" preview mode (a static QR with NO confirmation).
MY_UPI_ID=
